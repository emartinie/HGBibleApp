{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homegroups.org/data/investigations/published-investigation-schema.json",
  "title": "HomeGroups Published Investigation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "description", "investigations"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "investigations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/publishedInvestigation"
      }
    }
  },
  "$defs": {
    "stringId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relationshipCategories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scriptureReferences",
        "covenants",
        "commandments",
        "ancientSources",
        "intertext",
        "articles",
        "media",
        "relatedInvestigations"
      ],
      "properties": {
        "scriptureReferences": { "type": "array", "items": { "type": "object" } },
        "covenants": { "type": "array", "items": { "type": "object" } },
        "commandments": { "type": "array", "items": { "type": "object" } },
        "ancientSources": { "type": "array", "items": { "type": "object" } },
        "intertext": { "type": "array", "items": { "type": "object" } },
        "articles": { "type": "array", "items": { "type": "object" } },
        "media": { "type": "array", "items": { "type": "object" } },
        "relatedInvestigations": { "type": "array", "items": { "type": "object" } }
      }
    },
    "publishedInvestigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "file",
        "order",
        "publicationStatus",
        "reviewStatus",
        "relationships"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stringId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+\\.html$"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "publicationStatus": {
          "const": "published"
        },
        "reviewStatus": {
          "enum": ["unreviewed", "reviewing", "reviewed"]
        },
        "relationships": {
          "$ref": "#/$defs/relationshipCategories"
        }
      }
    }
  }
}
